# Same MariaDB instance dataset-downloader already writes to, but a
# separate database (agent_blackboard) and a separate, scoped user
# (SELECT/INSERT/UPDATE on agent_blackboard only, no DELETE, no access to
# any other database on the instance).
MARIADB_HOST=mariadb.default.svc.cluster.local
BLACKBOARD_DB=agent_blackboard
BLACKBOARD_USER=blackboard
BLACKBOARD_PASSWORD=

# Required so run_deployment() in flow/orchestrator_flow.py can reach the
# Prefect server to trigger workflow-prefect__ai-blackboard-task-runner's 'manual'
# deployment, AND so the reconcile pass can read a triggered run's state and
# logs (GET /flow_runs/{id}, POST /logs/filter).
PREFECT_API_URL=https://prefect.episerve.zib.de/api

# Optional. A 'running' row whose Prefect run never reaches a terminal state
# is forced to 'failed' after this many minutes.
MAX_RUNNING_AGE_MINUTES=360

# Optional. A COMPLETED run whose logs don't contain this line is treated as
# 'failed' (crashed / cut off mid-task). The task-runner harness-conventions
# skill tells the agent to emit it only on real success -- keep the two in
# sync if you change it.
AGENT_DONE_MARKER====AGENT_TASKS_COMPLETE===
